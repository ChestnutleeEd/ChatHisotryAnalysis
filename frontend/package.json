{
  "name": "chat-history-analysis-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0 <12.0.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run tests/*.test.ts",
    "test:browser:install": "playwright install chromium",
    "test:browser:dev": "node scripts/run-browser-tests.mjs development",
    "test:browser:preview": "npm run build && node scripts/run-browser-tests.mjs production"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "echarts": "5.6.0",
    "echarts-wordcloud": "2.1.0",
    "jieba-wasm": "2.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
